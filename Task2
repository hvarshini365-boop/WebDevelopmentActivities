        <p class="menu-note">Chef names and profiles are illustrative; replace them with your actual team.</p>
    </section>

    <!-- Testimonials -->
    <section class="testimonials section">
        <div class="section-heading">
            <p class="eyebrow">KIND WORDS</p>
            <h2>Stories from Our <em>Guests</em></h2>
        </div>

        <div class="review-grid">
            <article class="review-card">
                <div class="stars">★★★★★</div>
                <blockquote>"Every detail felt special, from the beautiful atmosphere to the incredible food. An evening we'll remember."</blockquote>
