        </div>
    </section>

    <!-- Reservation -->
    <section class="reservation-section section" id="reservation">
        <div class="reservation-info">
            <p class="eyebrow">YOUR TABLE AWAITS</p>
            <h2>Let's make it<br><em>an occasion.</em></h2>
            <p>Whether it's a quiet dinner for two or a celebration with friends, we'd love to welcome you.</p>

            <div class="contact-detail">
                <span>CALL US</span>
                <p>+91 98765 43210</p>
            </div>
            <div class="contact-detail">
                <span>EMAIL</span>
                <p>hello@maison.example</p>
            </div>
        </div>

        <form class="reservation-form" action="#" method="post">
            <h3>Reserve Your Table</h3>
            <p class="form-subtitle">Please share your dining preferences.</p>

            <div class="form-row">
                <div class="form-group">
                    <label for="name">Full Name</label>
                    <input type="text" id="name" name="name" placeholder="Your name" required>
                </div>
                <div class="form-group">
                    <label for="email">Email Address</label>
                    <input type="email" id="email" name="email" placeholder="you@example.com" required>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="date">Date</label>
                    <input type="date" id="date" name="date" required>
                </div>
                <div class="form-group">
                    <label for="time">Preferred Time</label>
                    <select id="time" name="time" required>
                        <option value="">Select time</option>
                        <option>12:00 PM</option>
                        <option>1:00 PM</option>
                        <option>2:00 PM</option>
                        <option>6:00 PM</option>
                        <option>7:00 PM</option>
                        <option>8:00 PM</option>
                        <option>9:00 PM</option>
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label for="guests">Number of Guests</label>
                <select id="guests" name="guests" required>
                    <option value="">Select guests</option>
                    <option>1 Guest</option>
                    <option>2 Guests</option>
                    <option>3 Guests</option>
                    <option>4 Guests</option>
                    <option>5 Guests</option>
                    <option>6 Guests</option>
                    <option>7+ Guests</option>
                </select>
            </div>

            <div class="form-group">
                <label for="message">Special Requests</label>
                <textarea id="message" name="message" rows="3" placeholder="Celebration, dietary needs, seating..."></textarea>
            </div>

            <button type="submit" class="btn btn-gold submit-btn">Request Reservation ↗</button>
            <p class="form-note">Demo form only. Connect a backend to receive reservations.</p>
        </form>
    </section>

    <!-- Location and Hours -->
    <section class="visit-section section" id="contact">
        <div class="section-heading">
            <p class="eyebrow">COME SAY HELLO</p>
            <h2>Find Your Way to <em>Us</em></h2>
        </div>

        <div class="visit-grid">
            <div class="visit-card">
                <span class="visit-icon">⌖</span>
                <h3>Our Location</h3>
                <p>12 Garden Avenue<br>Your City, India</p>
                <a href="https://www.google.com/maps" target="_blank" rel="noopener noreferrer" class="text-link">Get Directions ↗</a>
            </div>

            <div class="visit-card">
                <span class="visit-icon">◷</span>
                <h3>Opening Hours</h3>
                <p>Monday – Friday: 12 PM – 10 PM<br>
                   Saturday – Sunday: 11 AM – 11 PM</p>
                <span class="hours-note">Hours shown are sample details.</span>
            </div>

            <div class="visit-card">
                <span class="visit-icon">✉</span>
                <h3>Get in Touch</h3>
                <p>hello@maison.example<br>+91 98765 43210</p>
                <a href="mailto:hello@maison.example" class="text-link">Send Us a Message ↗</a>
            </div>
        </div>
    </section>

