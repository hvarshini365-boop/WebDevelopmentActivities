
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NEXUS | Gaming Portal</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700;800&family=Inter:wght@400;500;600;700&display=swap');

:root {
    --bg: #080910;
    --panel: #11131f;
    --panel2: #171a29;
    --purple: #a855f7;
    --cyan: #00e5ff;
    --pink: #ff3c91;
    --text: #f3f4ff;
    --muted: #9297b2;
    --border: rgba(255,255,255,.08);
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html { scroll-behavior: smooth; }

body {
    background:
        radial-gradient(ellipse at 80% 0%, #23103b 0, transparent 35%),
        var(--bg);
    color: var(--text);
    font-family: 'Inter', sans-serif;
    line-height: 1.6;
}

a { color: inherit; text-decoration: none; }
button { font: inherit; cursor: pointer; }

.container {
    width: min(1200px, 92%);
    margin: auto;
}

header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(8,9,16,.92);
    backdrop-filter: blur(18px);
    border-bottom: 1px solid var(--border);
}

.nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 76px;
    gap: 20px;
}

.logo {
    font: 800 25px 'Orbitron', sans-serif;
    letter-spacing: 2px;
    color: var(--cyan);
    text-shadow: 0 0 20px #00e5ff55;
}

.logo span { color: var(--purple); }

nav {
    display: flex;
    gap: 25px;
    flex-wrap: wrap;
}

nav a {
    color: var(--muted);
    font-size: 13px;
    transition: .25s;
}

nav a:hover { color: var(--cyan); }

.status {
    color: #68ffb0;
    font-size: 11px;
    white-space: nowrap;
}

.status::before {
    content: "";
    display: inline-block;
    width: 7px;
    height: 7px;
    background: #68ffb0;
    border-radius: 50%;
    margin-right: 7px;
    box-shadow: 0 0 10px #68ffb0;
}

/* HERO */

.hero {
    min-height: 420px;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
    padding: 65px 0;
    border-bottom: 1px solid var(--border);
    background:
        linear-gradient(90deg, #080910 5%, #080910dd 45%, #08091044),
        radial-gradient(circle at 75% 50%, #7024c766, transparent 40%);
}

.hero::after {
    content: "NEXUS";
    position: absolute;
    right: -20px;
    bottom: -80px;
    font: 800 clamp(100px, 19vw, 260px) 'Orbitron', sans-serif;
    color: #ffffff05;
    pointer-events: none;
}

.hero-content {
    position: relative;
    z-index: 1;
    max-width: 700px;
}

.eyebrow {
    color: var(--cyan);
    text-transform: uppercase;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 4px;
}

h1, h2, h3 { font-family: 'Orbitron', sans-serif; }

h1 {
    font-size: clamp(35px, 6vw, 68px);
    line-height: 1.15;
    margin: 17px 0;
}

.gradient {
    background: linear-gradient(90deg, var(--cyan), var(--purple), var(--pink));
    color: transparent;
    background-clip: text;
}

.hero p {
    color: var(--muted);
    max-width: 540px;
    margin-bottom: 27px;
}

.btn {
    display: inline-block;
    border: 1px solid var(--cyan);
    padding: 12px 22px;
    background: var(--cyan);
    color: #050711;
    font-size: 12px;
    font-weight: 800;
    border-radius: 4px;
    transition: .3s;
}

.btn:hover {
    box-shadow: 0 0 25px #00e5ff77;
    transform: translateY(-3px);
}

.btn.secondary {
    background: transparent;
    color: var(--text);
    border-color: var(--border);
    margin-left: 8px;
}

/* COMMON SECTIONS */

section { padding: 58px 0; }

.section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 20px;
    margin-bottom: 25px;
}

.section-heading h2 {
    font-size: clamp(19px, 3vw, 27px);
}

.section-heading p, .muted { color: var(--muted); font-size: 13px; }

.tag {
    display: inline-block;
    font-size: 10px;
    padding: 4px 9px;
    border-radius: 3px;
    background: #a855f71b;
    color: #d3a4ff;
    border: 1px solid #a855f733;
}

.cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.card {
    background: linear-gradient(145deg, var(--panel2), var(--panel));
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    transition: .3s;
}

.card:hover {
    transform: translateY(-6px);
    border-color: #a855f788;
    box-shadow: 0 10px 35px #a855f716;
}

.game-art {
    height: 170px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
}

.game-art span {
    font: 800 30px 'Orbitron', sans-serif;
    letter-spacing: 3px;
    text-shadow: 0 3px 20px #000;
}

.game-art small {
    position: absolute;
    bottom: 12px;
    left: 14px;
    font-size: 10px;
    letter-spacing: 2px;
}

.valorant {
    background: linear-gradient(135deg, #671d35, #e34e69, #28152d);
}
.dota {
    background: linear-gradient(135deg, #211a1a, #ac4437, #100c12);
}
.pubg {
    background: linear-gradient(135deg, #5a441c, #bb9146, #15131c);
}

.card-body { padding: 18px; }
.card-body h3 { font-size: 16px; margin-bottom: 7px; }
.card-body p { color: var(--muted); font-size: 12px; }

.card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 17px;
    font-size: 11px;
    color: var(--muted);
}

.card-footer a { color: var(--cyan); }

/* STATS */

.stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
    margin-top: -1px;
}

.stat {
    padding: 24px 12px;
    text-align: center;
    background: var(--panel);
    border: 1px solid var(--border);
    border-top: 2px solid var(--purple);
}

.stat strong {
    display: block;
    font: 700 26px 'Orbitron', sans-serif;
    color: var(--cyan);
}

.stat span {
    font-size: 11px;
    color: var(--muted);
}

/* TABLES */

.table-wrap {
    overflow-x: auto;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 9px;
}

table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    white-space: nowrap;
}

th {
    background: #191b2b;
    color: var(--muted);
    font-size: 10px;
    letter-spacing: 1px;
    text-transform: uppercase;
}

th, td {
    padding: 16px 19px;
    border-bottom: 1px solid var(--border);
    font-size: 12px;
}

tbody tr { transition: .2s; }
tbody tr:hover { background: #a855f710; }
tbody tr:last-child td { border-bottom: none; }

.rank {
    font: 700 15px 'Orbitron', sans-serif;
    color: var(--muted);
}

.gold { color: #ffd166; }
.silver { color: #c7d2e4; }
.bronze { color: #e99a66; }

.player {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
}

.avatar {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, #7028bc, #00a8c7);
    border-radius: 7px;
    font-weight: 800;
}

.positive { color: #69ffb0; }
.live { color: var(--pink); font-weight: 800; }

/* TWO-COLUMN CONTENT */

.split {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 25px;
    align-items: start;
}

.panel {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 9px;
    padding: 23px;
    min-width: 0;
}

.panel h3 { font-size: 15px; margin-bottom: 20px; }

.match {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 12px;
    padding: 18px 0;
    border-bottom: 1px solid var(--border);
}

.match:last-child { border: none; padding-bottom: 0; }
.match-team { font-size: 12px; font-weight: 700; }
.match-team:last-child { text-align: right; }
.match small { display: block; color: var(--muted); font-weight: 400; }
.vs { color: var(--purple); font: 700 13px 'Orbitron', sans-serif; }
.match-time { font-size: 10px; color: var(--cyan); text-align: center; }

.team-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.team {
    display: flex;
    gap: 13px;
    align-items: center;
    padding: 12px;
    background: #ffffff04;
    border: 1px solid var(--border);
    border-radius: 7px;
}

.team-logo {
    width: 43px;
    height: 43px;
    display: grid;
    place-items: center;
    background: #a855f722;
    color: var(--cyan);
    font: 800 13px 'Orbitron', sans-serif;
    border-radius: 8px;
}

.team-info { flex: 1; }
.team-info strong { font-size: 12px; display: block; }
.team-info small { color: var(--muted); font-size: 10px; }
.team-points { color: var(--cyan); font-size: 12px; font-weight: 700; }

/* PLAYER PROFILES */

.player-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
}

.player-card {
    text-align: center;
    padding: 23px 12px;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 9px;
    transition: .3s;
}

.player-card:hover {
    border-color: var(--cyan);
    box-shadow: 0 0 20px #00e5ff12;
}

.player-avatar {
    margin: 0 auto 13px;
    width: 68px;
    height: 68px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    font: 800 22px 'Orbitron', sans-serif;
    background: linear-gradient(135deg, #9c39e6, #123e75);
    border: 2px solid #ffffff22;
}

.player-card h3 { font-size: 12px; }
.player-card p { color: var(--muted); font-size: 11px; margin: 5px 0 12px; }

/* NEWS */

.news-art {
    height: 140px;
    display: grid;
    place-items: center;
    font: 700 24px 'Orbitron', sans-serif;
}

.news-one { background: linear-gradient(135deg, #20124c, #9235d7, #0c132c); }
.news-two { background: linear-gradient(135deg, #142d41, #1288a0, #11131f); }
.news-three { background: linear-gradient(135deg, #401326, #d83d67, #17101f); }

.news-meta {
    font-size: 10px;
    color: var(--cyan);
    margin-bottom: 9px;
}

.news-card h3 { line-height: 1.6; }

/* FOOTER */

footer {
    border-top: 1px solid var(--border);
    padding: 30px 0;
    text-align: center;
    color: var(--muted);
    font-size: 11px;
}

footer .logo { margin-bottom: 10px; display: inline-block; font-size: 20px; }

@keyframes glow {
    0%, 100% { text-shadow: 0 0 8px #00e5ff44; }
    50% { text-shadow: 0 0 24px #00e5ffbb; }
}

.logo { animation: glow 3s infinite; }

/* RESPONSIVE */

@media (max-width: 850px) {
    nav { gap: 13px; }
    .status { display: none; }
    .cards { grid-template-columns: repeat(2, 1fr); }
    .split { grid-template-columns: 1fr; }
    .player-grid { grid-template-columns: repeat(2, 1

